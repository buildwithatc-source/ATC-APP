# Supabase — consumed at build time by Vite (renderer) via import.meta.env.
# Copy this file to `.env` and fill in your project's values.
# Only the ANON key ships in the app. NEVER put the service_role key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
